{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "agent-to-earn",
  "dry_run": true,
  "dry_run_wallet": 340,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "liquidation_buffer": 0.1,
  "max_open_trades": 4,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "cancel_open_orders_on_exit": false,
  "initial_state": "running",
  "force_entry_enable": false,
  "recursive_strategy_search": true,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "market",
    "exit": "market",
    "emergency_exit": "market",
    "force_entry": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": true,
    "stoploss_on_exchange_interval": 60,
    "stoploss_price_type": "mark"
  },
  "exchange": {
    "name": "binance",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_blacklist": [
      "(USDC|FDUSD|TUSD|USDP|DAI|BUSD|EUR|USD1)/.*"
    ]
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "internals": {
    "process_throttle_secs": 5,
    "heartbeat_interval": 60
  },
  "add_config_files": [
    "config.pairs.json",
    "config.strategy.json"
  ]
}
