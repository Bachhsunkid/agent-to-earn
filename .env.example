# Copy to .env and fill in (`make env` generates the API_* secrets). Never commit .env.

# --- Required --------------------------------------------------------------------
# Telegram bot for urgent alerts: token from @BotFather, chat id of your private chat
# with the bot (send it a message, then `make chat-id` fills this in).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# FreqUI / dashboard login and Freqtrade API secrets: long random strings.
API_USERNAME=admin
API_PASSWORD=
API_JWT_SECRET=
API_WS_TOKEN=

# --- Research loop -----------------------------------------------------------------
# Long-lived Claude Code token from `claude setup-token` (uses your Claude subscription).
# Without it the bot still trades; the nightly research loop is skipped with an alert.
CLAUDE_CODE_OAUTH_TOKEN=
# Daily start time of the research loop, HH:MM in UTC.
RESEARCH_AT=01:00

# --- Live trading -------------------------------------------------------------------
# true = paper trading with a virtual wallet. false = real money: needs the Binance key
# (Futures enabled, withdrawals disabled, IP-restricted) and uses config.live.json.
DRY_RUN=true
BINANCE_KEY=
BINANCE_SECRET=

# --- Public status page ---------------------------------------------------------------
# The page runs on 127.0.0.1:8082. With "public" here it is also published through a
# Cloudflare quick tunnel (random URL: `make public-url`). Remove it to keep it local.
COMPOSE_PROFILES=public
